
# Backend server port
PORT=5000

# Set production when deploying
NODE_ENV=development

# DEPLOYMENT FIX:
# Generate a long, random secret.
# Never use a hardcoded JWT secret.
JWT_SECRET=replace_with_a_long_random_secret

# MongoDB connection string
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/inotebook

# Production:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/inotebook

# DEPLOYMENT FIX:
# Frontend URL allowed to access the backend.
# During production, replace with your actual Vercel URL.
CLIENT_URL=http://localhost:5173